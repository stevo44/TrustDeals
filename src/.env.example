# ─── Firebase ──────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_FIRESTORE_DATABASE_ID=   # leave blank for default

# ─── Fapshi ───────────────────────────────────────────────────
# Get these from https://fapshi.com/developers after registration
# Use sandbox credentials during development:
#   API user / key from https://sandbox.fapshi.com
VITE_FAPSHI_API_USER=your_fapshi_api_user
VITE_FAPSHI_API_KEY=your_fapshi_api_key
